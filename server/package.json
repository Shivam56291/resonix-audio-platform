{
  "name": "resonix-backend",
  "version": "1.0.0",
  "description": "Backend API for Resonix – a full-stack audio streaming application built with Node.js, TypeScript, MongoDB, and Express.",
  "license": "MIT",
  "author": "Shivam",
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsnd --respawn -r tsconfig-paths/register --pretty --transpile-only ./src/index.ts",
